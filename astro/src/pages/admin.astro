---
export const prerender = false

import BaseLayout from "@layouts/BaseLayout.astro"
import type Stripe from "stripe"
import {
    ADMIN_SESSION_COOKIE_NAME,
    isAdminUser,
    shouldUseSecureCookie,
    verifyAdminSessionToken,
} from "@utils/auth"

const sessionToken = Astro.cookies.get(ADMIN_SESSION_COOKIE_NAME)?.value

if (!sessionToken) {
    return Astro.redirect("/auth/login?returnTo=%2Fadmin")
}

const sessionClaims = await verifyAdminSessionToken(sessionToken)

if (!sessionClaims) {
    Astro.cookies.set(ADMIN_SESSION_COOKIE_NAME, "", {
        path: "/",
        httpOnly: true,
        sameSite: "lax",
        secure: shouldUseSecureCookie(Astro.url),
        maxAge: 0,
    })

    return Astro.redirect("/auth/login?returnTo=%2Fadmin")
}

if (!isAdminUser(sessionClaims.groups)) {
    return Astro.redirect("/403")
}

type NewsletterContact = {
    EmailAddress?: string
    LastUpdatedTimestamp?: string
    UnsubscribeAll?: boolean
    [key: string]: unknown
}

type CheckoutSessionLineItemSummary = Pick<
    Stripe.LineItem,
    "id" | "description" | "quantity" | "amount_total" | "currency"
>

type CheckoutSessionSummary = Pick<
    Stripe.Checkout.Session,
    | "id"
    | "created"
    | "status"
    | "payment_status"
    | "customer_email"
    | "amount_subtotal"
    | "amount_total"
    | "currency"
> & {
    amount_discount: number | null
    line_items: CheckoutSessionLineItemSummary[]
}

const checkoutDateFormatter = new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
})

function formatCheckoutSessionDate(unixTimestamp?: number): string {
    if (typeof unixTimestamp !== "number" || Number.isNaN(unixTimestamp)) return "—"
    try {
        const d = new Date(unixTimestamp * 1000)
        return checkoutDateFormatter.format(d)
    } catch {
        return "—"
    }
}

function formatCheckoutSessionAmount(amount?: number | null, currency?: string | null): string {
    if (typeof amount !== "number" || Number.isNaN(amount) || !currency) return "—"

    const normalisedCurrency = currency.toUpperCase()
    try {
        return new Intl.NumberFormat(undefined, {
            style: "currency",
            currency: normalisedCurrency,
        }).format(amount / 100)
    } catch {
        return `${(amount / 100).toFixed(2)} ${normalisedCurrency}`
    }
}

function formatCheckoutSessionDiscount(amount?: number | null, currency?: string | null): string {
    if (typeof amount !== "number" || Number.isNaN(amount) || amount <= 0) return "—"
    return `-${formatCheckoutSessionAmount(amount, currency)}`
}

function formatContactDate(iso?: string): string {
    if (!iso) return "—"
    try {
        const d = new Date(iso)
        return checkoutDateFormatter.format(d)
    } catch {
        return "—"
    }
}

let checkoutSessions: CheckoutSessionSummary[] = []
let newsletterContacts: NewsletterContact[] = []
const apiUrl = import.meta.env.PUBLIC_API_URL
const adminSecret = import.meta.env.ADMIN_API_SECRET
if (apiUrl && adminSecret) {
    try {
        const res = await fetch(apiUrl + "/sessions", {
            method: "GET",
            headers: { "X-Admin-Secret": adminSecret },
        })
        if (res.ok) {
            const data = (await res.json()) as { sessions?: CheckoutSessionSummary[] }
            const list = data.sessions ?? []
            checkoutSessions = [...list].sort((a, b) => (b.created ?? 0) - (a.created ?? 0))
        }
    } catch {
        // leave list empty on error
    }

    try {
        const res = await fetch(apiUrl + "/contacts", {
            method: "GET",
            headers: { "X-Admin-Secret": adminSecret },
        })
        if (res.ok) {
            const data = (await res.json()) as { contacts?: NewsletterContact[] }
            const list = data.contacts ?? []
            newsletterContacts = [...list].sort((a, b) => {
                const ta = a.LastUpdatedTimestamp ? new Date(a.LastUpdatedTimestamp).getTime() : 0
                const tb = b.LastUpdatedTimestamp ? new Date(b.LastUpdatedTimestamp).getTime() : 0
                return tb - ta
            })
        }
    } catch {
        // leave list empty on error
    }
}
---

<BaseLayout
    title="Admin | Andrea Diotallevi Art"
    description="Admin area."
    noIndex={true}
    hideFooter={true}
>
    <div class="max-w-screen-md mx-auto px-4 py-8 pt-0 md:pt-8">
        <h1 class="text-2xl md:text-5xl font-bold">Admin</h1>
        <p class="mt-4">
            You are authenticated as <strong>{sessionClaims.email || "admin user"}</strong>.
        </p>
        <section class="mt-10" aria-labelledby="checkout-sessions-heading">
            <h2 id="checkout-sessions-heading" class="text-xl font-semibold">
                Checkout sessions
                <span class="font-normal text-gray-500">({checkoutSessions.length})</span>
            </h2>
            <p class="mt-1 text-xs text-gray-500 md:hidden">
                Swipe horizontally to see all columns.
            </p>
            {checkoutSessions.length > 0 ? (
                <div class="mt-4 overflow-x-auto pb-1">
                    <div class="w-max min-w-full rounded border border-gray-200 bg-white">
                    <table class="min-w-[1120px] w-full border-collapse">
                        <thead>
                            <tr class="border-b border-gray-200 bg-white">
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Created
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Session ID
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Customer
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600">
                                    Line items
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Subtotal
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Discount
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Total
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Checkout status
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Payment status
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {checkoutSessions.map((session) => (
                                <tr class="border-b border-gray-100 last:border-b-0">
                                    <td class="px-3 py-2 text-gray-600 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatCheckoutSessionDate(session.created)}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 font-mono text-xs md:px-4 md:text-sm max-w-[180px] break-all whitespace-normal leading-tight">
                                        {session.id}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm break-all">
                                        {session.customer_email ? (
                                            <a
                                                href={`mailto:${session.customer_email}`}
                                                class="underline hover:text-gray-600"
                                            >
                                                {session.customer_email}
                                            </a>
                                        ) : (
                                            "—"
                                        )}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm min-w-[420px]">
                                        {session.line_items?.length ? (
                                            <ul class="space-y-1">
                                                {session.line_items.map((lineItem) => (
                                                    <li class="leading-snug">
                                                        <div class="break-words whitespace-normal">
                                                            <span class="font-medium">
                                                                {lineItem.quantity ?? 1}x
                                                            </span>{" "}
                                                            <span>{lineItem.description || "Item"}</span>
                                                        </div>
                                                        <div class="text-gray-500">
                                                            {formatCheckoutSessionAmount(
                                                                lineItem.amount_total,
                                                                lineItem.currency
                                                            )}
                                                        </div>
                                                    </li>
                                                ))}
                                            </ul>
                                        ) : (
                                            "—"
                                        )}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatCheckoutSessionAmount(
                                            session.amount_subtotal,
                                            session.currency
                                        )}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatCheckoutSessionDiscount(
                                            session.amount_discount,
                                            session.currency
                                        )}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatCheckoutSessionAmount(
                                            session.amount_total,
                                            session.currency
                                        )}
                                    </td>
                                    <td class="px-3 py-2 text-gray-600 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {session.status ?? "—"}
                                    </td>
                                    <td class="px-3 py-2 text-gray-600 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {session.payment_status ?? "—"}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                    </div>
                </div>
            ) : (
                <p class="mt-2 text-gray-600 dark:text-gray-400">
                    No checkout sessions yet.
                </p>
            )}
        </section>
        <section class="mt-10" aria-labelledby="newsletter-contacts-heading">
            <h2 id="newsletter-contacts-heading" class="text-xl font-semibold">
                Newsletter contacts
                <span class="font-normal text-gray-500">({newsletterContacts.length})</span>
            </h2>
            {newsletterContacts.length > 0 ? (
                <div class="mt-4 overflow-x-auto pb-1">
                    <div class="w-max min-w-full rounded border border-gray-200 bg-white">
                    <table class="min-w-[520px] w-full border-collapse">
                        <thead>
                            <tr class="border-b border-gray-200 bg-white">
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Last updated
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Email
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {newsletterContacts.map((c) => (
                                <tr class="border-b border-gray-100 last:border-b-0">
                                    <td class="px-3 py-2 text-gray-600 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatContactDate(c.LastUpdatedTimestamp)}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm break-all">
                                        <a
                                            href={`mailto:${c.EmailAddress ?? ""}`}
                                            class="underline hover:text-gray-600"
                                        >
                                            {c.EmailAddress ?? "—"}
                                        </a>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                    </div>
                </div>
            ) : (
                <p class="mt-2 text-gray-600 dark:text-gray-400">
                    No newsletter contacts yet. If you expect contacts, ensure{" "}
                    <code class="rounded bg-gray-200 px-1 dark:bg-gray-700">ADMIN_API_SECRET</code> is set (Netlify and
                    SSM) and matches.
                </p>
            )}
        </section>

        <div class="mt-8">
            <a
                href="/auth/logout"
                data-astro-reload
                class="block w-full max-w-lg rounded-lg border border-gray-300 bg-white px-4 py-3 text-center font-bold text-gray-800 transition-colors duration-300 md:hover:border-gray-800 md:hover:bg-gray-800 md:hover:text-white"
            >
                Sign out
            </a>
        </div>
    </div>
</BaseLayout>
