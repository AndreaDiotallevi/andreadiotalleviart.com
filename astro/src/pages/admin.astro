---
export const prerender = false

import BaseLayout from "@layouts/BaseLayout.astro"
import type Stripe from "stripe"
import type { Currency, StripeProduct } from "@utils/stripe"
import {
    ADMIN_SESSION_COOKIE_NAME,
    isAdminUser,
    shouldUseSecureCookie,
    verifyAdminSessionToken,
} from "@utils/auth"

const sessionToken = Astro.cookies.get(ADMIN_SESSION_COOKIE_NAME)?.value
const NOINDEX_ROBOTS_TAG = "noindex, nofollow, noarchive"

const redirectWithNoIndex = (location: string): Response =>
    new Response(null, {
        status: 302,
        headers: {
            Location: location,
            "X-Robots-Tag": NOINDEX_ROBOTS_TAG,
        },
    })

if (!sessionToken) {
    return redirectWithNoIndex("/auth/login?returnTo=%2Fadmin")
}

const sessionClaims = await verifyAdminSessionToken(sessionToken)

if (!sessionClaims) {
    Astro.cookies.set(ADMIN_SESSION_COOKIE_NAME, "", {
        path: "/",
        httpOnly: true,
        sameSite: "lax",
        secure: shouldUseSecureCookie(Astro.url),
        maxAge: 0,
    })

    return redirectWithNoIndex("/auth/login?returnTo=%2Fadmin")
}

if (!isAdminUser(sessionClaims.groups)) {
    return redirectWithNoIndex("/403")
}

Astro.response.headers.set("X-Robots-Tag", NOINDEX_ROBOTS_TAG)

type NewsletterContact = {
    EmailAddress?: string
    LastUpdatedTimestamp?: string
    UnsubscribeAll?: boolean
    [key: string]: unknown
}

type PromotionCodeSummary = Pick<
    Stripe.PromotionCode,
    "id" | "code" | "expires_at" | "times_redeemed" | "max_redemptions"
> & {
    discount: string
}

type CheckoutSessionLineItemSummary = Pick<
    Stripe.LineItem,
    "id" | "description" | "quantity" | "amount_total" | "currency"
>

type CheckoutSessionSummary = Pick<
    Stripe.Checkout.Session,
    | "id"
    | "created"
    | "status"
    | "payment_status"
    | "customer_email"
    | "amount_subtotal"
    | "amount_total"
    | "currency"
> & {
    order_id: string | null
    amount_discount: number | null
    line_items: CheckoutSessionLineItemSummary[]
}

const supportedProductCurrencies: Currency[] = ["gbp", "eur", "usd"]

const checkoutDateFormatter = new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
})

function formatCheckoutSessionDate(unixTimestamp?: number): string {
    if (typeof unixTimestamp !== "number" || Number.isNaN(unixTimestamp)) return "—"
    try {
        const d = new Date(unixTimestamp * 1000)
        return checkoutDateFormatter.format(d)
    } catch {
        return "—"
    }
}

function formatCheckoutSessionAmount(amount?: number | null, currency?: string | null): string {
    if (typeof amount !== "number" || Number.isNaN(amount) || !currency) return "—"

    const normalisedCurrency = currency.toUpperCase()
    try {
        return new Intl.NumberFormat(undefined, {
            style: "currency",
            currency: normalisedCurrency,
        }).format(amount / 100)
    } catch {
        return `${(amount / 100).toFixed(2)} ${normalisedCurrency}`
    }
}

function formatCheckoutSessionDiscount(amount?: number | null, currency?: string | null): string {
    if (typeof amount !== "number" || Number.isNaN(amount) || amount <= 0) return "—"
    return `-${formatCheckoutSessionAmount(amount, currency)}`
}

function formatProductPrice(product: StripeProduct, currency: Currency): string {
    const unitAmount = product.default_price?.currency_options?.[currency]?.unit_amount
    if (typeof unitAmount !== "number" || Number.isNaN(unitAmount)) return "—"
    return formatCheckoutSessionAmount(unitAmount, currency)
}

function formatContactDate(iso?: string): string {
    if (!iso) return "—"
    try {
        const d = new Date(iso)
        return checkoutDateFormatter.format(d)
    } catch {
        return "—"
    }
}

function formatPromotionCodeExpiry(unixTimestamp?: number | null): string {
    if (typeof unixTimestamp !== "number" || Number.isNaN(unixTimestamp)) return "No expiry"
    try {
        const d = new Date(unixTimestamp * 1000)
        return checkoutDateFormatter.format(d)
    } catch {
        return "—"
    }
}

function formatPromotionCodeRedemptions(
    timesRedeemed?: number,
    maxRedemptions?: number | null
): string {
    const safeTimesRedeemed =
        typeof timesRedeemed === "number" && !Number.isNaN(timesRedeemed)
            ? timesRedeemed
            : 0

    if (typeof maxRedemptions === "number" && !Number.isNaN(maxRedemptions)) {
        return `${safeTimesRedeemed} / ${maxRedemptions}`
    }

    return `${safeTimesRedeemed} / unlimited`
}

let availablePromotionCodes: PromotionCodeSummary[] = []
let checkoutSessions: CheckoutSessionSummary[] = []
let newsletterContacts: NewsletterContact[] = []
let activeProducts: StripeProduct[] = []
const apiUrl = import.meta.env.PUBLIC_API_URL
const adminSecret = import.meta.env.ADMIN_API_SECRET
if (apiUrl) {
    try {
        const res = await fetch(apiUrl + "/products", {
            method: "GET",
            headers: { "Content-Type": "application/json" },
        })
        if (res.ok) {
            const data = (await res.json()) as { products?: StripeProduct[] }
            const list = data.products ?? []
            activeProducts = list.filter(product => product.active)
        }
    } catch {
        // leave list empty on error
    }
}

if (apiUrl && adminSecret) {
    try {
        const res = await fetch(apiUrl + "/sessions", {
            method: "GET",
            headers: { "X-Admin-Secret": adminSecret },
        })
        if (res.ok) {
            const data = (await res.json()) as { sessions?: CheckoutSessionSummary[] }
            const list = data.sessions ?? []
            checkoutSessions = [...list].sort((a, b) => (b.created ?? 0) - (a.created ?? 0))
        }
    } catch {
        // leave list empty on error
    }

    try {
        const res = await fetch(apiUrl + "/promotion-codes", {
            method: "GET",
            headers: { "X-Admin-Secret": adminSecret },
        })
        if (res.ok) {
            const data = (await res.json()) as { promotionCodes?: PromotionCodeSummary[] }
            const list = data.promotionCodes ?? []
            availablePromotionCodes = [...list].sort((a, b) => a.code.localeCompare(b.code))
        }
    } catch {
        // leave list empty on error
    }

    try {
        const res = await fetch(apiUrl + "/contacts", {
            method: "GET",
            headers: { "X-Admin-Secret": adminSecret },
        })
        if (res.ok) {
            const data = (await res.json()) as { contacts?: NewsletterContact[] }
            const list = data.contacts ?? []
            newsletterContacts = [...list].sort((a, b) => {
                const ta = a.LastUpdatedTimestamp ? new Date(a.LastUpdatedTimestamp).getTime() : 0
                const tb = b.LastUpdatedTimestamp ? new Date(b.LastUpdatedTimestamp).getTime() : 0
                return tb - ta
            })
        }
    } catch {
        // leave list empty on error
    }
}
---

<BaseLayout
    title="Admin | Andrea Diotallevi Art"
    description="Admin area."
    noIndex={true}
    hideFooter={true}
>
    <div class="max-w-screen-md mx-auto px-4 py-8 pt-0 md:pt-8">
        <h1 class="text-2xl md:text-5xl font-bold">Admin</h1>
        <p class="mt-4">
            You are authenticated as <strong>{sessionClaims.email || "admin user"}</strong>.
        </p>
        <section class="mt-10" aria-labelledby="active-products-heading">
            <h2 id="active-products-heading" class="text-xl font-semibold">
                Active products
                <span class="font-normal text-gray-500">({activeProducts.length})</span>
            </h2>
            {activeProducts.length > 0 ? (
                <div class="mt-4 overflow-x-auto pb-1">
                    <div class="w-max min-w-full rounded border border-gray-200 bg-white">
                        <table class="min-w-[760px] w-full border-collapse">
                            <thead>
                                <tr class="border-b border-gray-200 bg-white">
                                    <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                        Image
                                    </th>
                                    <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600">
                                        Product
                                    </th>
                                    <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                        SKU
                                    </th>
                                    {supportedProductCurrencies.map((currency) => (
                                        <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                            {currency.toUpperCase()}
                                        </th>
                                    ))}
                                </tr>
                            </thead>
                            <tbody>
                                {activeProducts.map((product) => (
                                    <tr class="border-b border-gray-100 last:border-b-0">
                                        <td class="px-3 py-2 md:px-4">
                                            <div class="h-14 w-14 rounded border border-gray-200 bg-gray-100 p-1">
                                                {product.images?.[0] ? (
                                                    <img
                                                        src={product.images[0]}
                                                        alt={`${product.metadata.displayName} thumbnail`}
                                                        loading="lazy"
                                                        decoding="async"
                                                        width="56"
                                                        height="56"
                                                        class="h-full w-full rounded object-contain"
                                                    />
                                                ) : (
                                                    <div class="h-full w-full rounded bg-gray-200" />
                                                )}
                                            </div>
                                        </td>
                                        <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm">
                                            <div class="font-medium">{product.metadata.displayName}</div>
                                            {product.metadata.displaySubtitle ? (
                                                <div class="text-gray-500 text-xs mt-0.5">
                                                    {product.metadata.displaySubtitle}
                                                </div>
                                            ) : (
                                                <></>
                                            )}
                                        </td>
                                        <td class="px-3 py-2 text-gray-600 font-mono text-xs md:px-4 md:text-sm whitespace-nowrap">
                                            {product.metadata.sku}
                                        </td>
                                        {supportedProductCurrencies.map((currency) => (
                                            <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                                {formatProductPrice(product, currency)}
                                            </td>
                                        ))}
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            ) : (
                <p class="mt-2 text-gray-600 dark:text-gray-400">
                    No active products found.
                </p>
            )}
        </section>
        <section class="mt-10" aria-labelledby="checkout-sessions-heading">
            <h2 id="checkout-sessions-heading" class="text-xl font-semibold">
                Checkout sessions
                <span class="font-normal text-gray-500">({checkoutSessions.length})</span>
            </h2>
            {checkoutSessions.length > 0 ? (
                <div class="mt-4 overflow-x-auto pb-1">
                    <div class="w-max min-w-full rounded border border-gray-200 bg-white">
                    <table class="min-w-[1240px] w-full border-collapse">
                        <thead>
                            <tr class="border-b border-gray-200 bg-white">
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Created
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Session ID
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Order ID
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Customer
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600">
                                    Line items
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Subtotal
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Discount
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Total
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Checkout status
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Payment status
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {checkoutSessions.map((session) => (
                                <tr class="border-b border-gray-100 last:border-b-0">
                                    <td class="px-3 py-2 text-gray-600 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatCheckoutSessionDate(session.created)}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 font-mono text-xs md:px-4 md:text-sm max-w-[180px] break-all whitespace-normal leading-tight">
                                        {session.id}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {session.order_id ?? "—"}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm break-all">
                                        {session.customer_email ? (
                                            <a
                                                href={`mailto:${session.customer_email}`}
                                                class="underline hover:text-gray-600"
                                            >
                                                {session.customer_email}
                                            </a>
                                        ) : (
                                            "—"
                                        )}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm">
                                        {session.line_items?.length ? (
                                            <ul class="space-y-1">
                                                {session.line_items.map((lineItem) => (
                                                    <li class="leading-snug">
                                                        <div class="break-words whitespace-normal">
                                                            <span class="font-medium">
                                                                {lineItem.quantity ?? 1}x
                                                            </span>{" "}
                                                            <span>{lineItem.description || "Item"}</span>
                                                        </div>
                                                        <div class="text-gray-500">
                                                            {formatCheckoutSessionAmount(
                                                                lineItem.amount_total,
                                                                lineItem.currency
                                                            )}
                                                        </div>
                                                    </li>
                                                ))}
                                            </ul>
                                        ) : (
                                            "—"
                                        )}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatCheckoutSessionAmount(
                                            session.amount_subtotal,
                                            session.currency
                                        )}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatCheckoutSessionDiscount(
                                            session.amount_discount,
                                            session.currency
                                        )}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatCheckoutSessionAmount(
                                            session.amount_total,
                                            session.currency
                                        )}
                                    </td>
                                    <td class="px-3 py-2 text-gray-600 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {session.status ?? "—"}
                                    </td>
                                    <td class="px-3 py-2 text-gray-600 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {session.payment_status ?? "—"}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                    </div>
                </div>
            ) : (
                <p class="mt-2 text-gray-600 dark:text-gray-400">
                    No checkout sessions yet.
                </p>
            )}
        </section>
        <section class="mt-10" aria-labelledby="available-coupons-heading">
            <h2 id="available-coupons-heading" class="text-xl font-semibold">
                Available coupons
                <span class="font-normal text-gray-500">({availablePromotionCodes.length})</span>
            </h2>
            {availablePromotionCodes.length > 0 ? (
                <div class="mt-4 overflow-x-auto pb-1">
                    <div class="w-max min-w-full rounded border border-gray-200 bg-white">
                    <table class="min-w-[560px] w-full border-collapse">
                        <thead>
                            <tr class="border-b border-gray-200 bg-white">
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Code
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Discount
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Expires
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Redemptions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {availablePromotionCodes.map((promotionCode) => (
                                <tr class="border-b border-gray-100 last:border-b-0">
                                    <td class="px-3 py-2 text-gray-800 font-mono text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {promotionCode.code}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {promotionCode.discount}
                                    </td>
                                    <td class="px-3 py-2 text-gray-600 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatPromotionCodeExpiry(promotionCode.expires_at)}
                                    </td>
                                    <td class="px-3 py-2 text-gray-600 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatPromotionCodeRedemptions(
                                            promotionCode.times_redeemed,
                                            promotionCode.max_redemptions
                                        )}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                    </div>
                </div>
            ) : (
                <p class="mt-2 text-gray-600 dark:text-gray-400">
                    No available coupons yet.
                </p>
            )}
        </section>
        <section class="mt-10" aria-labelledby="newsletter-contacts-heading">
            <h2 id="newsletter-contacts-heading" class="text-xl font-semibold">
                Newsletter contacts
                <span class="font-normal text-gray-500">({newsletterContacts.length})</span>
            </h2>
            {newsletterContacts.length > 0 ? (
                <div class="mt-4 overflow-x-auto pb-1">
                    <div class="w-max min-w-full rounded border border-gray-200 bg-white">
                    <table class="min-w-full w-full border-collapse table-auto">
                        <thead>
                            <tr class="border-b border-gray-200 bg-white">
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Last updated
                                </th>
                                <th class="px-3 py-2 text-left text-xs md:px-4 md:text-sm font-medium text-gray-600 whitespace-nowrap">
                                    Email
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {newsletterContacts.map((c) => (
                                <tr class="border-b border-gray-100 last:border-b-0">
                                    <td class="px-3 py-2 text-gray-600 text-xs md:px-4 md:text-sm whitespace-nowrap">
                                        {formatContactDate(c.LastUpdatedTimestamp)}
                                    </td>
                                    <td class="px-3 py-2 text-gray-800 text-xs md:px-4 md:text-sm break-all whitespace-normal">
                                        <a
                                            href={`mailto:${c.EmailAddress ?? ""}`}
                                            class="inline-block break-all whitespace-normal underline hover:text-gray-600"
                                        >
                                            {c.EmailAddress ?? "—"}
                                        </a>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                    </div>
                </div>
            ) : (
                <p class="mt-2 text-gray-600 dark:text-gray-400">
                    No newsletter contacts yet. If you expect contacts, ensure{" "}
                    <code class="rounded bg-gray-200 px-1 dark:bg-gray-700">ADMIN_API_SECRET</code> is set (Netlify and
                    SSM) and matches.
                </p>
            )}
        </section>

        <div class="mt-8">
            <a
                href="/auth/logout"
                data-astro-reload
                class="block w-full max-w-lg rounded-lg border border-gray-300 bg-white px-4 py-3 text-center font-bold text-gray-800 transition-colors duration-300 md:hover:border-gray-800 md:hover:bg-gray-800 md:hover:text-white"
            >
                Sign out
            </a>
        </div>
    </div>
</BaseLayout>
